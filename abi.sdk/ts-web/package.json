{
  "name": "@anylink/abi-web-sdk",
  "version": "1.0.0",
  "description": "ABI Web, H5, H5-App Bridge, WeChat MiniProgram, React Native, Cocos Creator, Egret, LayaAir & Weex Analytics SDK (ThinkingData v3.4 compatible)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
