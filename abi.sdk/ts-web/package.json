      "types": "./dist/adapters/miniapp.d.ts",
      "default": "./dist/adapters/miniapp.js"
    },
    "./adapters/react-native": {
      "types": "./dist/adapters/react-native.d.ts",
      "default": "./dist/adapters/react-native.js"
    },
    "./adapters/h5-bridge": {
      "types": "./dist/adapters/h5-bridge.d.ts",
      "default": "./dist/adapters/h5-bridge.js"
    },
    "./adapters/game-engines": {
      "types": "./dist/adapters/game-engines.d.ts",
      "default": "./dist/adapters/game-engines.js"
    }
  },
  "scripts": {
    "build": "test": },
  "keywords": [
    "abi",
    "analytics",
    "uba",
    "thinkingdata",
    "sdk"
